#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

exec docker run --rm \
  --cap-add=SYS_ADMIN \
  --mount "type=bind,source=$project_dir,target=/src,readonly" \
  --env FANOTIFY_REQUIRE_INTEGRATION=1 \
  "${RUBY_IMAGE:-ruby:3.4}" \
  sh -eu -c '
    # Build from source in the container, without reusing host build artifacts.
    mkdir -p /work
    tar -C /src --exclude=Makefile --exclude=mkmf.log --exclude="*.o" \
      --exclude="*.so" --exclude="*.gem" --exclude=pkg \
      --exclude=.bundle --exclude=vendor --exclude=Gemfile.lock \
      -cf - Gemfile Rakefile gems script | tar -C /work -xf -
    cd /work
    bundle install
    bundle exec rake test

    sh script/check-packages
  '
